{
  "name": "isoline",
  "productName": "Isoline",
  "version": "1.18.0",
  "description": "Isoline — real-time territorial conquest on a living night atlas.",
  "author": "Isoline Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "bench": "tsx scripts/bench.ts",
    "maps:fetch": "node scripts/maps/fetch-ne.mjs",
    "maps": "node scripts/maps/fetch-ne.mjs && tsx scripts/maps/build-maps.ts",
    "brand": "tsx scripts/brand/build-brand.ts",
    "package:mac": "npm run build && node scripts/package.mjs mac",
    "package:win": "npm run build && node scripts/package.mjs win",
    "package:all": "npm run build && node scripts/package.mjs mac win",
    "verify:packages": "node scripts/verify-packages.mjs",
    "bench:app": "npm run build && node scripts/perf-app.mjs",
    "media": "npm run build && node scripts/media.mjs",
    "audio:sfx": "node scripts/audio/fetch-sfx.mjs",
    "audio:music": "node scripts/audio/fetch-music.mjs",
    "audio:voice": ".tools/venv/bin/python scripts/audio/gen-voice.py",
    "pacing": "tsx scripts/pacing.ts",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-png": "^8.0.0",
    "ffmpeg-static": "^5.3.0",
    "flag-icons": "^7.5.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "lefthook": "^2.1.16",
    "lucide": "^1.49.0",
    "opentype.js": "^2.0.0",
    "pixi.js": "^8.21.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "resedit": "^3.1.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lefthook@2.1.16": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
